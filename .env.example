FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=whatdis
DB_USER=app
DB_PASSWORD=your-db-password-here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# JWT cookie settings
# JWT_COOKIE_SAMESITE=Lax  # Lax | Strict | None
# Set FLASK_ENV=production to enable Secure flag on cookies

# Rate limiting (uses Redis db 1)
RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# Trusted proxy hops for Werkzeug ProxyFix.
# Nginx only: PROXY_FIX_X_FOR=1. Cloudflare + Nginx: 2, only if direct access cannot spoof headers.
PROXY_FIX_X_FOR=2
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1

# CORS - comma-separated list of allowed origins (no wildcard when credentials are used)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_SUCCESS_URL=http://localhost:5173/subscription/success
STRIPE_CANCEL_URL=http://localhost:5173/subscription/cancel
STRIPE_PRICE_PRO_WEEKLY=price_eur_weekly
STRIPE_PRICE_PRO_MONTHLY=price_eur_monthly
STRIPE_PRICE_PRO_YEARLY=price_eur_yearly
STRIPE_PRICE_PRO_WEEKLY_USD=price_usd_weekly
STRIPE_PRICE_PRO_MONTHLY_USD=price_usd_monthly
STRIPE_PRICE_PRO_YEARLY_USD=price_usd_yearly
STRIPE_PRICE_PRO_WEEKLY_GBP=price_gbp_weekly
STRIPE_PRICE_PRO_MONTHLY_GBP=price_gbp_monthly
STRIPE_PRICE_PRO_YEARLY_GBP=price_gbp_yearly
STRIPE_PRICE_NRG_BOOSTER_1K=price_nrg_1k
STRIPE_PRICE_NRG_BOOSTER_5K=price_nrg_5k
STRIPE_PRICE_NRG_BOOSTER_10K=price_nrg_10k

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Web Push notifications
# Generate once with: python -m py_vapid --gen
# Then get the browser key with: python -m py_vapid --applicationServerKey --private-key private_key.pem
VAPID_PUBLIC_KEY=your-application-server-key
VAPID_PRIVATE_KEY=private_key.pem
VAPID_SUBJECT=mailto:support@whatdis.nl
