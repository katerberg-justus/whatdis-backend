FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=whatdis
DB_USER=app
DB_PASSWORD=your-db-password-here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# JWT cookie settings
# JWT_COOKIE_SAMESITE=Lax  # Lax | Strict | None
# Set FLASK_ENV=production to enable Secure flag on cookies

# Rate limiting (uses Redis db 1)
RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# CORS — comma-separated list of allowed origins (no wildcard when credentials are used)
CORS_ORIGINS=http://localhost:5173

# Guess limits by tier
GUESS_LIMIT_ANONYMOUS=15
GUESS_LIMIT_USER=30
GUESS_LIMIT_SUBSCRIBER=100

# Daily challenge limits by tier
DAILY_LIMIT_ANONYMOUS=1
DAILY_LIMIT_USER=1
DAILY_LIMIT_SUBSCRIBER=8

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
